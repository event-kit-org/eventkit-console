# Build-time settings (Vercel project → Environment Variables, or .env locally).
# The API to talk to: eventkit-serverless (main) or eventkit-api, by URL.
#   Local: /api (the dev server proxies it to localhost:4000).
#   Vercel: https://<eventkit-serverless deployment or its domain>
VITE_API_URL=/api
# Sent as X-Api-Key: must equal the API's PLATFORM_API_KEY. It is visible in the
# bundle by design: it only says which app is calling and grants nothing.
VITE_PLATFORM_API_KEY=change-me-platform-key-change-me-platform-key
